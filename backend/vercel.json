{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.3",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "maxDuration": 30
    }
  },
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "@app-key",
    "DB_CONNECTION": "pgsql",
    "DB_HOST": "@db-host",
    "DB_PORT": "5432",
    "DB_DATABASE": "@db-name",
    "DB_USERNAME": "@db-user",
    "DB_PASSWORD": "@db-password",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "QUEUE_CONNECTION": "sync",
    "LOG_CHANNEL": "stderr",
    "LOG_LEVEL": "error",
    "SANCTUM_STATEFUL_DOMAINS": "@vercel-url",
    "FRONTEND_URL": "https://afasya-projects.vercel.app",
    "CORS_ALLOWED_ORIGINS": "https://afasya-projects.vercel.app"
  }
}