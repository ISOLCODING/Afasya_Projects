# Frontend Environment Variables - DEVELOPMENT
# Salin file ini ke .env.production untuk environment production

# Base URL aplikasi
VITE_BASE_URL=/

# URL API backend (ganti dengan URL Vercel backend setelah deploy)
# Untuk development: http://127.0.0.1:8000
# Untuk production: https://afasya-projects-backend.vercel.app
VITE_API_URL=http://127.0.0.1:8000

# Nama aplikasi
VITE_APP_NAME="Afasya Projects"