# 🟢 AFASYA PROJECTS - VERCEL ENVIRONMENT VARIABLES (ROOT)
# Salin nilai-nilai ini ke Vercel Dashboard -> Settings -> Environment Variables

# --- BACKEND (LARAVEL) ---
APP_NAME="Afasya Projects"
APP_ENV=production
APP_KEY=                # Ambil dari backend/.env lokal
APP_DEBUG=false
APP_URL=                # URL Vercel setelah deploy

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
VIEW_COMPILED_PATH=/tmp
FILESYSTEM_DISK=public

# --- FRONTEND (REACT/VITE) ---
VITE_API_URL=          # URL Vercel Backend (contoh: https://project.vercel.app/api)
VITE_APP_NAME="Afasya Projects"
